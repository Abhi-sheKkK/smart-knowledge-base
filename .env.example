# OpenCode: optional, overrides the organiser key built into kb/config.py
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1/chat/completions
ANTHROPIC_BASE_URL=https://opencode.ai/inference/anthropic
FAST_MODEL=claude-haiku-5-5
ANSWER_MODEL=claude-haiku-5-5
# optional: override per-model prices (USD per 1M tokens) for cost reporting
# PRICE_IN_PER_M=
# PRICE_OUT_PER_M=

# Langfuse (required for scoring cost/latency)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Tuning
LLM_CONCURRENCY=8
WORKERS=8
